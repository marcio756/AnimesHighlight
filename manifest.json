{
  "manifest_version": 3,
  "name": "Universal MAL Highlighter",
  "version": "1.6",
  "description": "Automatically highlights anime/manga cards and monitors new releases.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "src/background/main.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/common/i18n.js",
        "src/content/utils.js",
        "src/content/data.js",
        "src/content/ui.js",
        "src/content/main.js"
      ],
      "css": ["src/content/styles.css"]
    }
  ]
}